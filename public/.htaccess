# Apache-Konfiguration fuer das Hosting bei all-inkl (statischer Next-Export).
# Ersetzt headers()/redirects() aus next.config.ts, die im Export-Modus
# nicht verfuegbar sind.

Options -Indexes
DirectoryIndex index.html
# Next legt neben kontakt.html auch einen Ordner kontakt/ an (RSC-Daten).
# Ohne das haengt Apache an /kontakt einen Slash an, bevor die Rewrite-Regel
# unten greift.
DirectorySlash Off
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # --- HTTPS + www als kanonischer Host ---------------------------------
    # Nur fuer die Produktionsdomains, damit eine Vorschau-Subdomain
    # (z. B. neu.raedlog.de) zum Testen nicht umgeleitet wird.
    RewriteCond %{HTTP_HOST} ^(www\.)?(raedlog|xn--rdlog-gra)\.de$ [NC]
    RewriteCond %{HTTP_HOST} !^www\.raedlog\.de$ [NC]
    RewriteRule ^ https://www.raedlog.de%{REQUEST_URI} [R=301,L,NE]

    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP_HOST} ^www\.raedlog\.de$ [NC]
    RewriteRule ^ https://www.raedlog.de%{REQUEST_URI} [R=301,L,NE]

    # --- URLs der alten Seite (2012) auf die neuen Seiten -------------------
    RewriteRule ^index\.php$ / [R=301,L]
    RewriteRule ^chronik\.php$ /ueber-uns#chronik [R=301,L,NE]
    RewriteRule ^(firmenkunden|vorteile-einlagerung)\.php$ /firmenkunden [R=301,L]
    RewriteRule ^(leistungspakete|ablauf-raedereinlagerung|serviceleistungen)\.php$ /leistungen [R=301,L]
    RewriteRule ^onlinesystem-reos\.php$ /reos [R=301,L]
    RewriteRule ^login-reos\.php$ https://reos.raedlog.de/ [R=301,L]
    RewriteRule ^kontakt\.php$ /kontakt [R=301,L]
    RewriteRule ^download\.php$ /downloads/raedlog-flyer.pdf [R=301,L]
    RewriteRule ^impressum\.php$ /impressum [R=301,L]
    RewriteRule ^datenschutz\.php$ /datenschutz [R=301,L]
    RewriteRule ^download/?$ /downloads/raedlog-flyer.pdf [R=301,L]

    # --- Neue Seite ---------------------------------------------------------
    RewriteRule ^chronik/?$ /ueber-uns#chronik [R=301,L,NE]

    # /kontakt/ -> /kontakt (kanonisch ohne Slash)
    RewriteCond %{REQUEST_FILENAME} ^(.+)/$
    RewriteCond %1.html -f
    RewriteRule ^(.+)/$ /$1 [R=301,L]

    # /kontakt -> kontakt.html (statischer Export)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^(.+)$ $1.html [L]
</IfModule>

# --- Dateitypen ---------------------------------------------------------------
AddType image/avif .avif
AddType image/webp .webp
AddType video/mp4 .mp4
AddType video/webm .webm
AddType application/manifest+json .webmanifest
AddType text/plain .txt
AddDefaultCharset utf-8
AddCharset utf-8 .txt .xml .webmanifest

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

# --- Security-Header ----------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
    # Bewusst ohne includeSubDomains/preload: reos.raedlog.de und die
    # anderen Subdomains sollen davon unberuehrt bleiben.
    Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"

    # RSC-Daten des Exports (kontakt.txt, __next.*.txt usw.) sind fuer den
    # Client-Router gedacht, nicht fuer den Suchindex. robots.txt und
    # llms*.txt bleiben ausgenommen.
    <If "%{REQUEST_URI} =~ m#\.txt$# && %{REQUEST_URI} !~ m#^/(robots|llms|llms-full)\.txt$#">
        Header set X-Robots-Tag "noindex"
    </If>
</IfModule>

# --- Caching ------------------------------------------------------------------
<IfModule mod_headers.c>
    # HTML immer frisch pruefen, damit Updates sofort sichtbar sind.
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    # llms.txt: von KI-Crawlern gelesen, maessig cachen.
    <FilesMatch "^llms(-full)?\.txt$">
        Header set Cache-Control "public, max-age=3600"
    </FilesMatch>
</IfModule>

# Gehashte Next-Bundles sowie Medien mit stabilen Namen: lang cachebar.
# (Bei inhaltlichen Aenderungen an Medien werden die Dateien umbenannt.)
<If "%{REQUEST_URI} =~ m#^/(_next/static|frames|images|logos|videos)/# || %{REQUEST_URI} =~ m#^/(og-image\.jpg|favicon\.ico)$#">
    Header set Cache-Control "public, max-age=31536000, immutable"
</If>
